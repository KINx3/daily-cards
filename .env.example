# 로컬 실행용 — .env로 복사해서 사용 (CI는 GitHub Secrets/Variables 사용)
ANTHROPIC_API_KEY=

# 토픽별 설정 (미설정 시 기본값: review / 토픽 기본 브랜드)
PUBLISH_MODE_ANI=review
PUBLISH_MODE_TECH=review
PUBLISH_MODE_GROWTH=review
BRAND_ANI=ANI·CARDS
BRAND_TECH=TECH·CARDS
BRAND_GROWTH=GROW·CARDS

# 자동 발행(2단계) 전까지는 비워둠 — 토픽별 IG 계정
IG_ACCESS_TOKEN_ANI=
IG_USER_ID_ANI=
IG_ACCESS_TOKEN_TECH=
IG_USER_ID_TECH=
IG_ACCESS_TOKEN_GROWTH=
IG_USER_ID_GROWTH=
