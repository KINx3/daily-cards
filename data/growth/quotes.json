[
  { "id": "gq-durant", "quote": "우리는 반복적으로 하는 행동 그 자체다.\n탁월함은 행위가 아니라 습관이다.", "by": "윌 듀런트", "source": "철학 이야기 (아리스토텔레스 요약)", "verified": false },
  { "id": "gq-seneca", "quote": "행운은 준비가 기회를 만날 때 찾아온다.", "by": "세네카", "source": "", "verified": false },
